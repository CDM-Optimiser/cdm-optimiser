# Copy to .env.local and fill in the values from the Supabase dashboard:
# Project Settings → API Keys. They are bundled into the client build, so use
# the publishable key (sb_publishable_…) only, never a secret key
# (sb_secret_…). The build refuses anything else.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

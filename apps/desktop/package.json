{
  "name": "@cdm-optimiser/desktop",
  "version": "1.1.0",
  "description": "CDM Optimiser desktop application",
  "author": "CDM Optimiser Developers",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "build:renderer": "yarn workspace @cdm-optimiser/web build --outDir ../desktop/renderer --emptyOutDir",
    "dev": "yarn build && concurrently --kill-others --names web,electron \"yarn workspace @cdm-optimiser/web dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "yarn build && yarn build:renderer && electron-builder --win --publish never",
    "pack:dir": "yarn build && yarn build:renderer && electron-builder --dir",
    "start": "yarn build && yarn build:renderer && electron .",
    "test": "yarn build && node --test 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@cdm-optimiser/desktop-bridge": "workspace:*",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.1",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}

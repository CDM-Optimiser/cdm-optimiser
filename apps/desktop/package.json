{
  "name": "@cdm-optimiser/desktop",
  "version": "1.0.0",
  "description": "CDM Optimiser desktop application",
  "author": "CDM Optimiser Developers",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "yarn workspace @cdm-optimiser/web build --outDir ../desktop/renderer --emptyOutDir",
    "dev": "concurrently --kill-others --names web,electron \"yarn workspace @cdm-optimiser/web dev\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist": "yarn build:renderer && electron-builder --win --publish never",
    "pack:dir": "yarn build:renderer && electron-builder --dir",
    "start": "yarn build:renderer && electron ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.5.1"
  }
}

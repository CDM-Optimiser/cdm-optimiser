{
  "name": "cdm-optimiser",
  "version": "1.3.0",
  "description": "CDM Optimiser",
  "author": "CDM Optimiser Developers",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24.15"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:web": "yarn workspace @cdm-optimiser/web build",
    "bump": "node scripts/bump-version.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "dev:desktop": "yarn workspace @cdm-optimiser/desktop dev",
    "dev:web": "yarn workspace @cdm-optimiser/web dev",
    "dist:desktop": "yarn workspace @cdm-optimiser/desktop dist",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "linc": "node scripts/lint-changed.mjs",
    "lint": "eslint . --max-warnings 0",
    "prettier": "node scripts/prettier-changed.mjs",
    "test": "yarn workspaces foreach --all --exclude cdm-optimiser run test",
    "test:e2e": "yarn workspace @cdm-optimiser/web test:e2e",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "eslint": "^10.14.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CDM-Optimiser/cdm-optimiser.git"
  }
}
